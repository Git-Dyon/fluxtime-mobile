# Backend do FluxTime. `EXPO_PUBLIC_` é obrigatório: só variáveis com esse
# prefixo são embutidas no bundle do app (Expo SDK 49+).
#
# "localhost" NÃO funciona aqui como funciona no navegador — o app roda num
# processo separado (emulador ou celular físico), não na máquina de dev:
#   - Emulador Android:  http://10.0.2.2:3741/api      (loopback especial do emulador para o host)
#   - Celular físico:    http://<IP-da-sua-máquina-na-rede>:3741/api
#   - iOS Simulator:     http://localhost:3741/api      (esse sim funciona, mesma máquina)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3741/api
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3741
